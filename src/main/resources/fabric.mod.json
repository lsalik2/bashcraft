{
	"schemaVersion": 1,
	"id": "bashcraft",
	"version": "${version}",
	"name": "BashCraft",
	"description": "A bash shell for the command line: set timers, chain commands and much more.",
	"authors": ["lsalik2"],
	"contact": {
		"homepage": "https://github.com/lsalik2/bashcraft/tree/main/docs/guide",
		"sources": "https://github.com/lsalik2/bashcraft",
		"issues": "https://github.com/lsalik2/bashcraft/issues"
	},
	"license": "MIT",
	"icon": "assets/bashcraft/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": ["net.slk.bashcraft.Bashcraft"],
		"client": ["net.slk.bashcraft.BashcraftClient"]
	},
	"mixins": ["bashcraft.mixins.json", "bashcraft.transparent.mixins.json", "bashcraft.client.mixins.json", "bashcraft.suggest.mixins.json"],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}
